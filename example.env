# nextendo-account — example configuration. Copy to ".env"; NEVER commit real secrets.

# Where JSON state lives (accounts, sessions, bans…).
NEXTENDO_DATA_DIR=./data
# Public base URL of this service.
NEXTENDO_BASE_URL=https://nextendo.network

# --- Secrets (set to strong random values) ---
# Signs the nx2. NEX login tokens the game servers verify. MUST match the game servers.
NEXTENDO_SECRET=change-me
NEXTENDO_SIGN_KEY=change-me
# Shared key for /internal/* control-plane routes.
NEXTENDO_INTERNAL_KEY=change-me

# --- Admin space (closed until you list at least one e-mail) ---
NEXTENDO_ADMIN_EMAILS=you@example.com
NEXTENDO_ADMIN_KEY=change-me

# --- E-mail (SMTP) — leave HOST empty for dev/log mode ---
NEXTENDO_SMTP_HOST=
NEXTENDO_SMTP_PORT=587
NEXTENDO_SMTP_USER=
NEXTENDO_SMTP_PASS=
NEXTENDO_SMTP_FROM=Nextendo Network <no-reply@nextendo.network>

# --- Game servers (presence/stats) & Discord verify bot ---
DASH_MK8_URL=http://localhost:8082
DASH_S2_URL=http://localhost:8083
DASH_SSBU_URL=http://localhost:8084
DASH_ACNH_URL=http://localhost:8086
NEXTENDO_BOT_URL=http://localhost:8080
NEXTENDO_REQUIRE_DISCORD=0
